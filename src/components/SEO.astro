---
export interface Props {
	title: string;
	description: string;
	url: string;
	image?: string;
	siteName?: string;
	type?: 'website' | 'article';
	locale?: string;
	noindex?: boolean;
	keywords?: string | string[];
}

const {
	title,
	description,
	url,
	image = '/banner.png',
	siteName = 'TheArkTech',
	type = 'website',
	locale = 'en_IN',
	noindex = false,
	keywords,
} = Astro.props as Props;

const canonicalUrl = url;
const absoluteImage = image.startsWith('http') ? image : new URL(image, url).toString();
const keywordsContent = Array.isArray(keywords) ? keywords.join(', ') : (keywords || '').trim();

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'ProfessionalService',
			'@id': 'https://thearktech.in/#organization',
			name: 'TheArkTech',
			url: 'https://thearktech.in/',
			logo: { '@type': 'ImageObject', url: 'https://thearktech.in/logo.png' },
			image: 'https://thearktech.in/banner.png',
			description:
				'Software development agency in Coimbatore building websites, web and mobile apps, and AI-powered automation for businesses.',
			telephone: '+91-94897-22142',
			email: 'contact@thearktech.in',
			address: {
				'@type': 'PostalAddress',
				addressLocality: 'Coimbatore',
				addressRegion: 'Tamil Nadu',
				addressCountry: 'IN',
			},
			areaServed: ['Coimbatore', 'Tamil Nadu', 'India'],
			openingHours: 'Mo-Sa 10:00-19:00',
			priceRange: '₹₹',
		},
		{
			'@type': 'WebSite',
			name: 'TheArkTech',
			url: 'https://thearktech.in/',
			publisher: { '@id': 'https://thearktech.in/#organization' },
		},
	],
};
---
<title>{title}</title>
<meta name="description" content={description} />
{keywordsContent && <meta name="keywords" content={keywordsContent} />}
<link rel="canonical" href={canonicalUrl} />

{noindex ? <meta name="robots" content="noindex,nofollow" /> : <meta name="robots" content="index,follow" />}

<meta property="og:site_name" content={siteName} />
<meta property="og:type" content={type} />
<meta property="og:locale" content={locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={absoluteImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />

<meta name="theme-color" content="#000000" />

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

