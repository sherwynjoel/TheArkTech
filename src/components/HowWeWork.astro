---
const steps = [
  {
    num: "01",
    title: "Initial Consultation",
    tag: "Free · 30 min",
    desc: "We schedule a free discovery call to understand your business, goals, target audience, and budget. No commitments, no sales pitch — just a genuine conversation to see if we're the right fit.",
  },
  {
    num: "02",
    title: "Requirement Analysis & Proposal",
    tag: "2–3 business days",
    desc: "Our team analyses your requirements and prepares a detailed scope document covering the proposed tech stack, sitemap, feature list, timeline, and a fixed-price quotation with no hidden costs.",
  },
  {
    num: "03",
    title: "Contract, Kickoff & Advance",
    tag: "Day 1",
    desc: "Once you approve the proposal, we sign a project agreement, collect the advance payment, and assign a dedicated project manager. You get a shared workspace (Notion) with the full project roadmap.",
  },
  {
    num: "04",
    title: "UI/UX Design & Prototype Approval",
    tag: "Week 1–2",
    desc: "We design every screen as wireframes and high-fidelity Figma mockups. You review, comment, and approve before a single line of production code is written — design changes after this stage are out of scope.",
  },
  {
    num: "05",
    title: "Agile Development & Weekly Demos",
    tag: "Ongoing sprints",
    desc: "We build in one-week sprints. After each sprint you receive a live staging link and a progress update. Feedback is welcomed every week; no waiting until the end to see what you're getting.",
  },
  {
    num: "06",
    title: "Quality Assurance & Testing",
    tag: "Final 1–2 weeks",
    desc: "Rigorous QA across devices, browsers, and screen sizes. We test load speed, security headers, form flows, payment gateways, and all user journeys. Bugs found here are fixed before go-live — zero exceptions.",
  },
  {
    num: "07",
    title: "Deployment, Handover & Support",
    tag: "Go-live day +",
    desc: "We handle production deployment, domain DNS, SSL certificates, and a go-live checklist. You receive full source code, an admin guide, and a dedicated support window (1–3 months) for bug fixes and minor updates.",
  },
];
---
<section id="process" class="relative py-28">
  <div class="container-x lg:grid lg:grid-cols-12 lg:gap-16">

    <!-- sticky left sidebar (desktop only) -->
    <aside class="hidden lg:block lg:col-span-4">
      <div class="lg:sticky lg:top-28">
        <p class="eyebrow mb-3">Our process</p>
        <h2 class="font-display text-[clamp(2rem,4vw,3.25rem)] leading-[1.04]">
          Standard<br />Operating<br />Procedure
        </h2>
        <p class="mt-4 max-w-sm text-ink-muted">
          Seven defined steps — so you always know where things stand, what comes next, and who is responsible.
        </p>

        <!-- step counter -->
        <div class="sop-counter mt-8">
          <span class="sop-counter-cur" id="sop-cur">01</span>
          <span class="sop-counter-sep">/</span>
          <span class="sop-counter-tot">{String(steps.length).padStart(2, "0")}</span>
        </div>

        <nav class="sop-index mt-6" aria-label="Jump to a step">
          <ul>
            {steps.map((s) => (
              <li>
                <a href={`#sop-${s.num}`} class="sop-index-link" data-target={`sop-${s.num}`}>
                  <span class="sop-index-num">{s.num}</span>
                  <span class="sop-index-title">{s.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </aside>

    <!-- right: step blocks -->
    <div class="lg:col-span-8">
      <!-- mobile heading -->
      <div class="lg:hidden mb-12">
        <p class="eyebrow mb-3">Our process</p>
        <h2 class="font-display text-[clamp(2rem,7vw,2.75rem)] leading-[1.05]">Standard Operating Procedure</h2>
      </div>

      <div class="sop-list" id="sop-list">
        <!-- scroll progress rail -->
        <div class="sop-rail" aria-hidden="true">
          <div class="sop-rail-fill" id="sop-rail-fill"></div>
        </div>

        {steps.map((s) => (
          <article id={`sop-${s.num}`} class="sop-block reveal">
            <span class="sop-num" aria-hidden="true">{s.num}</span>
            <div class="sop-body">
              <div class="sop-head">
                <h3 class="font-display text-2xl md:text-3xl">{s.title}</h3>
                <span class="sop-tag">{s.tag}</span>
              </div>
              <p class="mt-3 max-w-xl text-ink-muted">{s.desc}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="sop-closer reveal">
        <p class="font-display text-2xl md:text-3xl">
          Every step is documented.<br />
          <span class="text-brand-bright">Every deadline is owned.</span>
        </p>
        <a href="#contact" class="btn-glass mt-6">Start your project</a>
      </div>
    </div>

  </div>
</section>

<style>
  /* ── sticky index ── */
  .sop-index ul { list-style: none; margin: 0; padding: 0; }
  .sop-index-link {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.75rem 0;
    color: var(--ink-muted);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    transition: color 0.25s ease;
  }
  .sop-index li:last-child .sop-index-link { border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
  .sop-index-num {
    font-family: "Clash Display", sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    min-width: 1.6rem;
    opacity: 0.7;
    transition: color 0.25s ease, opacity 0.25s ease;
  }
  .sop-index-title { font-size: 0.95rem; transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .sop-index-link:hover { color: var(--ink); }
  .sop-index-link.is-active { color: var(--ink); }
  .sop-index-link.is-active .sop-index-num { color: var(--brand-bright); opacity: 1; }
  .sop-index-link.is-active .sop-index-title { transform: translateX(5px); }

  /* ── step counter ── */
  .sop-counter {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }
  .sop-counter-cur {
    font-family: "Clash Display", sans-serif;
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1;
    background: linear-gradient(135deg, var(--brand-bright), var(--accent-cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    transition: all 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .sop-counter-sep { color: var(--ink-faint); font-size: 1rem; margin: 0 2px; }
  .sop-counter-tot { font-family: "Clash Display", sans-serif; font-size: 1rem; color: var(--ink-faint); }

  /* ── progress rail ── */
  .sop-list {
    position: relative;
    padding-left: 1.25rem;
  }
  .sop-rail {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgba(255, 255, 255, 0.07);
    border-radius: 2px;
    overflow: hidden;
  }
  .sop-rail-fill {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 0%;
    background: linear-gradient(to bottom, var(--brand), var(--accent-cyan));
    border-radius: 2px;
    transition: height 0.15s linear;
    box-shadow: 0 0 8px rgba(96, 165, 250, 0.6);
  }

  /* ── step blocks ── */
  .sop-block {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 clamp(1.25rem, 3vw, 2.25rem);
    align-items: start;
    padding: clamp(2rem, 4vw, 2.75rem) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    scroll-margin-top: 7rem;
    position: relative;
    /* left accent bar */
    transition: border-color 0.4s ease;
  }
  .sop-list .sop-block:first-child { border-top: 0; padding-top: 0; }

  /* left accent bar — hidden by default, visible when active */
  .sop-block::before {
    content: "";
    position: absolute;
    left: -1.25rem;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--brand-bright), var(--accent-cyan));
    border-radius: 2px;
    box-shadow: 0 0 10px rgba(96, 165, 250, 0.7);
    transform: scaleY(0);
    transform-origin: top center;
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .sop-block.is-active::before { transform: scaleY(1); }

  /* ── entrance: slide from right (overrides global translateY reveal) ── */
  .sop-block.reveal {
    opacity: 0;
    transform: translateX(50px) !important;
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) !important;
  }
  .sop-block.reveal.is-in {
    opacity: 1;
    transform: none !important;
  }

  /* ── active state ── */
  .sop-num {
    font-family: "Clash Display", sans-serif;
    font-weight: 700;
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    line-height: 0.9;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.2);
    transition: -webkit-text-stroke-color 0.4s ease, text-shadow 0.4s ease;
  }
  .sop-block.is-active .sop-num {
    -webkit-text-stroke-color: var(--brand-bright);
    filter: drop-shadow(0 0 8px rgba(96, 165, 250, 0.5));
  }
  .sop-block:hover .sop-num { -webkit-text-stroke-color: rgba(96, 165, 250, 0.6); }

  /* body dims slightly when not active (only after first block is active) */
  .sop-list.has-active .sop-block:not(.is-active) .sop-body {
    opacity: 0.55;
    transition: opacity 0.4s ease;
  }
  .sop-list.has-active .sop-block.is-active .sop-body {
    opacity: 1;
    transition: opacity 0.4s ease;
  }

  .sop-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .sop-tag {
    font-size: 0.72rem;
    padding: 3px 10px;
    border-radius: 9999px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.25);
    color: var(--accent-cyan);
    letter-spacing: 0.04em;
    white-space: nowrap;
    transition: background 0.4s, border-color 0.4s;
  }
  .sop-block.is-active .sop-tag {
    background: rgba(34, 211, 238, 0.18);
    border-color: rgba(34, 211, 238, 0.5);
  }

  .sop-closer {
    margin-top: clamp(2rem, 4vw, 2.75rem);
    padding-top: clamp(2rem, 4vw, 2.75rem);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-left: 1.25rem;
  }

  @media (max-width: 1023px) {
    .sop-num { font-size: clamp(2rem, 9vw, 2.75rem); }
    .sop-list { padding-left: 0; }
    .sop-rail { display: none; }
    .sop-block::before { display: none; }
    .sop-closer { padding-left: 0; }
    .sop-list.has-active .sop-block:not(.is-active) .sop-body { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sop-block.reveal { transform: none !important; }
    .sop-block::before { transition: none; }
    .sop-rail-fill { transition: none; }
    .sop-counter-cur { transition: none; }
  }
</style>

<script>
  const blocks  = Array.from(document.querySelectorAll<HTMLElement>(".sop-block"));
  const links   = Array.from(document.querySelectorAll<HTMLAnchorElement>(".sop-index-link"));
  const list    = document.getElementById("sop-list")!;
  const railFill = document.getElementById("sop-rail-fill")!;
  const curEl   = document.getElementById("sop-cur");
  const byId    = new Map(links.map((l) => [l.dataset.target, l]));

  function setActive(id: string) {
    // index links
    links.forEach((l) => l.classList.remove("is-active"));
    byId.get(id)?.classList.add("is-active");

    // blocks
    blocks.forEach((b) => b.classList.remove("is-active"));
    const activeBlock = document.getElementById(id);
    if (activeBlock) activeBlock.classList.add("is-active");
    list.classList.add("has-active");

    // step counter
    const idx = blocks.findIndex((b) => b.id === id);
    if (curEl && idx >= 0) {
      curEl.textContent = String(idx + 1).padStart(2, "0");
    }
  }

  // Scroll-spy
  const spy = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) setActive(e.target.id);
      }
    },
    { rootMargin: "-45% 0px -45% 0px", threshold: 0 }
  );
  blocks.forEach((b) => spy.observe(b));

  // Progress rail — fills as user scrolls through the sop-list
  function updateRail() {
    if (!list) return;
    const rect = list.getBoundingClientRect();
    const scrollable = rect.height - window.innerHeight;
    const progress = scrollable > 0
      ? Math.max(0, Math.min(100, (-rect.top / scrollable) * 100))
      : rect.top < window.innerHeight / 2 ? 100 : 0;
    railFill.style.height = `${progress}%`;
  }
  window.addEventListener("scroll", updateRail, { passive: true });
  updateRail();
</script>
