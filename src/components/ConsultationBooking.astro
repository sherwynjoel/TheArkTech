---
// Replace this URL with your actual Calendly / Cal.com link
const BOOKING_URL = "https://calendly.com/thearktech/free-consultation";

const perks = [
  { icon: "clock",   text: "30 minutes, no obligation" },
  { icon: "users",   text: "Direct call with our lead developer" },
  { icon: "zap",     text: "Get a scope & cost estimate on the call" },
  { icon: "shield",  text: "No sales pressure — just honest advice" },
];
---

<section id="book" class="py-28 relative overflow-hidden">
  <!-- ambient background -->
  <div class="book-bg" aria-hidden="true">
    <div class="book-blob book-blob--1"></div>
    <div class="book-blob book-blob--2"></div>
  </div>

  <div class="container-x relative">
    <div class="book-card reveal">
      <div class="book-left">
        <p class="eyebrow mb-3">Free consultation</p>
        <h2 class="font-display text-[clamp(1.9rem,4vw,3rem)] leading-[1.05]">
          Book a free<br />
          <span class="text-brand-bright">30-minute call</span>
        </h2>
        <p class="mt-4 text-ink-muted max-w-sm">
          Tell us your idea — we'll tell you how to build it, how long it takes, and what it costs. Zero pressure.
        </p>

        <ul class="book-perks">
          {perks.map((p) => (
            <li>
              <span class="book-perk-dot" aria-hidden="true">✓</span>
              {p.text}
            </li>
          ))}
        </ul>
      </div>

      <div class="book-right">
        <div class="book-cta-card">
          <p class="book-cta-title">Pick a time that suits you</p>
          <p class="book-cta-sub">Available Monday – Saturday, 10 AM – 7 PM IST</p>

          <a
            href={BOOKING_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="book-btn"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            Book free call
          </a>

          <p class="book-or">or reach us directly</p>

          <div class="book-contacts">
            <a href="mailto:contact@thearktech.in" class="book-contact-link">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              contact@thearktech.in
            </a>
            <a href="https://wa.me/919489722142" target="_blank" rel="noopener noreferrer" class="book-contact-link">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 2C8.268 2 2 8.268 2 16c0 2.49.65 4.826 1.787 6.854L2 30l7.336-1.756A13.94 13.94 0 0 0 16 30c7.732 0 14-6.268 14-14S23.732 2 16 2zm6.328 19.928c-.346-.173-2.047-1.01-2.364-1.125-.317-.116-.548-.173-.779.173-.23.347-.894 1.126-1.096 1.357-.202.23-.404.26-.75.086-.346-.174-1.46-.538-2.782-1.716-1.028-.916-1.722-2.047-1.924-2.393-.202-.347-.021-.534.152-.707.156-.155.346-.404.52-.606.173-.202.23-.347.346-.578.115-.23.058-.433-.029-.606-.086-.173-.779-1.878-1.068-2.572-.28-.674-.566-.583-.78-.594l-.664-.01c-.23 0-.606.086-.924.433-.317.347-1.212 1.184-1.212 2.887 0 1.703 1.241 3.349 1.414 3.58.173.23 2.44 3.724 5.913 5.224.827.356 1.47.568 1.974.728.829.263 1.583.226 2.179.137.664-.099 2.047-.837 2.335-1.645.288-.808.288-1.501.202-1.645-.086-.144-.317-.23-.663-.404z"/></svg>
              WhatsApp us
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ambient blobs */
  .book-bg { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .book-blob {
    position: absolute;
    border-radius: 9999px;
    filter: blur(80px);
    will-change: transform;
  }
  .book-blob--1 {
    top: -6rem; left: -8rem;
    width: 28rem; height: 28rem;
    background: radial-gradient(circle, rgba(30,58,138,0.55), transparent 65%);
    animation: blob-drift-1 18s ease-in-out infinite alternate;
  }
  .book-blob--2 {
    bottom: -4rem; right: -6rem;
    width: 24rem; height: 24rem;
    background: radial-gradient(circle, rgba(34,211,238,0.12), transparent 65%);
    animation: blob-drift-2 22s ease-in-out infinite alternate;
  }
  @keyframes blob-drift-1 { from { transform: translate(0,0); } to { transform: translate(20px,14px); } }
  @keyframes blob-drift-2 { from { transform: translate(0,0); } to { transform: translate(-16px,-18px); } }
  @media (prefers-reduced-motion: reduce) { .book-blob { animation: none; } }

  /* card */
  .book-card {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    grid-template-columns: 1fr;
    padding: clamp(2rem, 4vw, 3rem);
    background: rgba(10, 14, 26, 0.7);
    border: 1px solid rgba(96, 165, 250, 0.2);
    border-radius: 2rem;
    box-shadow: 0 0 60px rgba(59, 130, 246, 0.08);
  }
  @media (min-width: 640px) { .book-card { grid-template-columns: 1fr 1fr; align-items: center; } }

  /* perks list */
  .book-perks {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .book-perks li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: var(--ink-muted);
  }
  .book-perk-dot {
    color: var(--accent-cyan);
    font-size: 0.75rem;
    flex: none;
  }

  /* right CTA card */
  .book-cta-card {
    padding: clamp(1.5rem, 3vw, 2rem);
    background: var(--glass-bg);
    border: 1px solid var(--glass-brd);
    border-radius: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .book-cta-title {
    font-family: "Clash Display", sans-serif;
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0;
  }
  .book-cta-sub {
    font-size: 0.82rem;
    color: var(--ink-faint);
    margin: 0;
  }

  .book-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.95rem 1.75rem;
    border-radius: 9999px;
    background: linear-gradient(120deg, var(--brand-deep), var(--brand) 60%, var(--brand-bright));
    color: #fff;
    font-weight: 600;
    font-size: 0.95rem;
    box-shadow: 0 6px 24px rgba(59,130,246,0.35);
    transition: transform 0.25s, box-shadow 0.25s;
    margin-top: 0.25rem;
  }
  .book-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 36px rgba(59,130,246,0.5); }

  .book-or {
    font-size: 0.78rem;
    color: var(--ink-faint);
    text-align: center;
    margin: 0.25rem 0 0;
  }

  .book-contacts {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .book-contact-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--ink-muted);
    transition: color 0.2s;
  }
  .book-contact-link:hover { color: var(--brand-bright); }
</style>
