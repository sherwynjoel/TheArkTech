---
const plans = [
  {
    name: "Starter",
    price: "₹25,000",
    period: "one-time",
    tagline: "Perfect for small businesses getting online",
    features: [
      "Up to 5 pages",
      "Mobile-responsive design",
      "Basic SEO setup",
      "Contact form",
      "1 month support",
      "Delivery in 2 weeks",
    ],
    cta: "Get started",
    highlight: false,
  },
  {
    name: "Growth",
    price: "₹65,000",
    period: "one-time",
    tagline: "Full website + e-commerce or dynamic features",
    features: [
      "Up to 15 pages",
      "E-commerce or CMS integration",
      "Advanced SEO + sitemap",
      "Admin dashboard",
      "Payment gateway setup",
      "3 months support",
      "Delivery in 4–5 weeks",
    ],
    cta: "Most popular",
    highlight: true,
  },
  {
    name: "Enterprise",
    price: "Custom",
    period: "project-based",
    tagline: "Custom software, AI tools, and complex apps",
    features: [
      "Unlimited scope",
      "Custom software / mobile app",
      "AI & automation integration",
      "Cloud architecture",
      "Dedicated project manager",
      "Long-term maintenance plan",
    ],
    cta: "Let's talk",
    highlight: false,
  },
];
---
<section id="pricing" class="py-28">
  <div class="container-x">
    <div class="max-w-2xl mb-14 mx-auto text-center">
      <p class="eyebrow mb-3">Pricing</p>
      <h2 class="font-display text-[clamp(2rem,4vw,3.25rem)] leading-[1.05]">
        Simple, transparent pricing
      </h2>
      <p class="mt-4 text-ink-muted">
        No hidden costs. Every project includes design, development, testing, and deployment.
      </p>
    </div>

    <div class="pricing-grid">
      {plans.map((p) => (
        <div class={`plan-card reveal ${p.highlight ? "plan-card--highlight" : ""}`}>
          {p.highlight && <div class="plan-badge">Most Popular</div>}
          <p class="plan-name">{p.name}</p>
          <div class="plan-price">
            <span class="plan-amount">{p.price}</span>
            <span class="plan-period">/{p.period}</span>
          </div>
          <p class="plan-tagline">{p.tagline}</p>
          <ul class="plan-features">
            {p.features.map((f) => (
              <li>
                <span class="check" aria-hidden="true">✓</span>
                {f}
              </li>
            ))}
          </ul>
          <a href="#contact" class={`plan-cta ${p.highlight ? "plan-cta--primary" : "btn-glass"}`}>
            {p.cta} →
          </a>
        </div>
      ))}
    </div>

    <p class="mt-10 text-center text-sm text-ink-faint">
      All prices are starting estimates in INR. Final quote depends on project complexity.
      <a href="#contact" class="text-brand-bright hover:underline ml-1">Talk to us for an exact quote.</a>
    </p>
  </div>
</section>

<style>
  .pricing-grid {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 768px) { .pricing-grid { grid-template-columns: repeat(3, 1fr); } }

  .plan-card {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2rem);
    background: var(--glass-bg);
    border: 1px solid var(--glass-brd);
    border-radius: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.3s, transform 0.3s;
  }
  .plan-card:hover { transform: translateY(-4px); border-color: rgba(96,165,250,0.3); }

  .plan-card--highlight {
    background: linear-gradient(160deg, rgba(30,58,138,0.5), rgba(8,12,22,0.8));
    border-color: rgba(96, 165, 250, 0.5);
    box-shadow: 0 0 40px rgba(59, 130, 246, 0.15);
  }

  .plan-badge {
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(90deg, var(--brand), var(--accent-cyan));
    color: #000;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 4px 14px;
    border-radius: 0 0 10px 10px;
    text-transform: uppercase;
  }

  .plan-name {
    font-family: "Clash Display", sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: 0.5rem;
  }

  .plan-price { display: flex; align-items: baseline; gap: 4px; }
  .plan-amount {
    font-family: "Clash Display", sans-serif;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--ink);
  }
  .plan-period { font-size: 0.85rem; color: var(--ink-faint); }

  .plan-tagline { font-size: 0.88rem; color: var(--ink-muted); line-height: 1.5; margin: 0; }

  .plan-features {
    list-style: none;
    padding: 0; margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(255,255,255,0.08);
  }
  .plan-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.88rem;
    color: var(--ink-muted);
  }
  .check {
    color: var(--accent-cyan);
    font-size: 0.8rem;
    margin-top: 2px;
    flex: none;
  }

  .plan-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.5rem;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 0.9rem;
    text-align: center;
    transition: transform 0.25s, box-shadow 0.25s;
    margin-top: 0.5rem;
  }
  .plan-cta:hover { transform: translateY(-2px); }

  .plan-cta--primary {
    background: linear-gradient(120deg, var(--brand-deep), var(--brand) 60%, var(--brand-bright));
    color: #fff;
    border: none;
    box-shadow: 0 6px 24px rgba(59,130,246,0.35);
  }
  .plan-cta--primary:hover { box-shadow: 0 10px 36px rgba(59,130,246,0.5); }
</style>
