---
/**
 * Lightweight inline icon set (stroke geometry from open-source icon families,
 * normalized to a 24x24 viewBox, 1.75 stroke, currentColor). Dependency-free so
 * it fits the existing static-Astro setup. Add new glyphs to `icons` as needed.
 */
interface Props { name: string; class?: string; }
const { name, class: className = "" } = Astro.props as Props;

const icons: Record<string, string> = {
  // trust strip
  pin: `<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/>`,
  commit: `<circle cx="12" cy="12" r="3"/><line x1="3" y1="12" x2="9" y2="12"/><line x1="15" y1="12" x2="21" y2="12"/>`,
  grid: `<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/>`,
  shield: `<path d="M12 3 5 6v5.5c0 4.5 3 7 7 8.5 4-1.5 7-4 7-8.5V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>`,
  // services
  window: `<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/><path d="M6.5 6.5h.01M9.5 6.5h.01"/>`,
  bag: `<path d="M6 8h12l-1 11a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1L6 8Z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>`,
  mobile: `<rect x="6.5" y="2.5" width="11" height="19" rx="2.5"/><path d="M10.5 18.5h3"/>`,
  cpu: `<rect x="6" y="6" width="12" height="12" rx="2"/><rect x="9.5" y="9.5" width="5" height="5" rx="1"/><path d="M9 2.5v2.5M15 2.5v2.5M9 19v2.5M15 19v2.5M2.5 9H5M2.5 15H5M19 9h2.5M19 15h2.5"/>`,
  design: `<path d="M15.5 4.5 19.5 8.5 9 19l-4.5 1L6 15.5 15.5 4.5Z"/><path d="m13.5 6.5 4 4"/>`,
  growth: `<path d="M3 17l5.5-5.5 3.5 3.5L21 7"/><path d="M15 7h6v6"/>`,
  // why choose us
  bulb: `<path d="M9 18h6"/><path d="M10 21.5h4"/><path d="M12 2.5a6 6 0 0 0-3.6 10.8c.7.55 1.1 1.05 1.3 1.7h4.6c.2-.65.6-1.15 1.3-1.7A6 6 0 0 0 12 2.5Z"/>`,
  zap: `<path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z"/>`,
  lock: `<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>`,
  lifebuoy: `<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.2"/><path d="m5.6 5.6 3.8 3.8M18.4 5.6l-3.8 3.8M5.6 18.4l3.8-3.8M18.4 18.4l-3.8-3.8"/>`,
  layout: `<rect x="3" y="3" width="18" height="18" rx="2.5"/><path d="M3 9h18"/><path d="M9 9v12"/>`,
  message: `<path d="M20.5 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.9A8 8 0 1 1 20.5 12Z"/>`,
  sliders: `<path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2.2"/><circle cx="8" cy="17" r="2.2"/>`,
  trophy: `<path d="M8 4h8v4.5a4 4 0 0 1-8 0V4Z"/><path d="M8 6H5.5v1a3 3 0 0 0 3 3M16 6h2.5v1a3 3 0 0 1-3 3"/><path d="M12 12.5v3M9 20h6M9.5 20l.5-2h4l.5 2"/>`,
};

const inner = icons[name] ?? "";
---
<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
  set:html={inner}
></svg>
