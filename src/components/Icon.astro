  // industries
  pulse: `<rect x="2.75" y="4.5" width="18.5" height="15" rx="3"/><path d="M6 12.2h2.6l1.5-3.3 2.3 6.2 1.7-4.3 1 1.4H18"/>`,
  building: `<path d="M4 20.5V6a1.5 1.5 0 0 1 1.5-1.5h6A1.5 1.5 0 0 1 13 6v14.5"/><path d="M13 10.5h5.5A1.5 1.5 0 0 1 20 12v8.5"/><path d="M2.5 20.5h19"/><path d="M7 8h3M7 11.5h3M7 15h3M16 14h1.5M16 17h1.5"/>`,
