  calculator: `<rect x="5" y="2.5" width="14" height="19" rx="2.75"/><rect x="8" y="5.75" width="8" height="3.25" rx="1"/><path d="M8.5 13.25h.01M12 13.25h.01M15.5 13.25h.01M8.5 17h.01M12 17h.01M15.5 17h.01"/>`,
