---
const stats = [
  { value: 200, suffix: "+", label: "Projects Completed" },
  { value: 4,   suffix: "+", label: "Years Experience" },
  { value: 50,  suffix: "+", label: "Technologies Mastered" },
];
---
<section id="stats" class="py-20 border-y border-white/8">
  <div class="container-x">
    <ul class="stats-grid">
      {stats.map((s) => (
        <li class="stat-item reveal">
          <div class="stat-val">
            <span class="stat-num" data-target={s.value}>0</span>
            <span class="stat-suffix">{s.suffix}</span>
          </div>
          <p class="stat-label">{s.label}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .stats-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px;
  }
  @media (min-width: 480px) { .stats-grid { grid-template-columns: repeat(3, 1fr); } }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(2rem, 4vw, 3rem) 1rem;
    text-align: center;
    position: relative;
  }
  .stat-item::after {
    content: "";
    position: absolute;
    inset: 6px;
    border-radius: 1.25rem;
    background: var(--glass-bg);
    border: 1px solid var(--glass-brd);
    z-index: -1;
    transition: background 0.3s, border-color 0.3s;
  }
  .stat-item:hover::after {
    background: rgba(59, 130, 246, 0.08);
    border-color: rgba(96, 165, 250, 0.35);
  }

  /* number + suffix on one row */
  .stat-val {
    display: flex;
    align-items: baseline;
    gap: 2px;
  }

  .stat-num {
    font-family: "Clash Display", sans-serif;
    font-size: clamp(2.8rem, 6vw, 4.5rem);
    font-weight: 700;
    line-height: 1;
    background: linear-gradient(135deg, var(--ink) 0%, var(--brand-bright) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .stat-suffix {
    font-family: "Clash Display", sans-serif;
    font-size: clamp(1.6rem, 3.5vw, 2.5rem);
    font-weight: 700;
    color: var(--accent-cyan);
  }

  .stat-label {
    margin-top: 0.6rem;
    font-size: 0.88rem;
    color: var(--ink-muted);
    letter-spacing: 0.02em;
  }
</style>

<script>
  function countUp(item: HTMLElement) {
    const numEl = item.querySelector<HTMLElement>(".stat-num");
    if (!numEl) return;
    const target = Number(numEl.dataset.target);
    const duration = 1800;
    const start = performance.now();
    function tick(now: number) {
      const t = Math.min((now - start) / duration, 1);
      const ease = 1 - Math.pow(1 - t, 3);
      numEl.textContent = String(Math.floor(ease * target));
      if (t < 1) requestAnimationFrame(tick);
      else numEl.textContent = String(target);
    }
    requestAnimationFrame(tick);
  }

  const obs = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        countUp(e.target as HTMLElement);
        obs.unobserve(e.target);
      }
    });
  }, { threshold: 0.4 });

  document.querySelectorAll<HTMLElement>(".stat-item").forEach((el) => obs.observe(el));
</script>
