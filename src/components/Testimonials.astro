---
const testimonials = [
  {
    name: "Priya Nair",
    role: "Founder, ShopNest",
    industry: "E-Commerce",
    avatar: "PN",
    stars: 5,
    quote:
      "TheArkTech delivered our full e-commerce platform in under 6 weeks — product catalogue, payments, admin dashboard, everything. The quality and speed blew us away. Sales were live before we expected.",
  },
  {
    name: "Dr. Ravi Menon",
    role: "Director, HealthFirst Clinics",
    industry: "Healthcare",
    avatar: "RM",
    stars: 5,
    quote:
      "They built a patient booking system that cut our front-desk workload in half. It's fast, secure, and our staff loves it. TheArkTech truly understood what a medical practice needs.",
  },
  {
    name: "Arun Thambi",
    role: "CEO, FinEdge Consultants",
    industry: "Finance",
    avatar: "AT",
    stars: 5,
    quote:
      "Our old website looked unprofessional. TheArkTech redesigned it and handled the SEO — we now rank on page one for three key terms in Coimbatore. Leads doubled within two months.",
  },
  {
    name: "Meera Suresh",
    role: "Co-founder, EduSpark",
    industry: "EdTech",
    avatar: "MS",
    stars: 5,
    quote:
      "From the first call to launch, TheArkTech was communicative and transparent. Our learning portal handles 500+ students and hasn't missed a beat. Highly recommend for any startup.",
  },
];
---
<section id="testimonials" class="py-28">
  <div class="container-x">
    <div class="max-w-2xl mb-14 mx-auto text-center">
      <p class="eyebrow mb-3">Client stories</p>
      <h2 class="font-display text-[clamp(2rem,4vw,3.25rem)] leading-[1.05]">
        What our clients say
      </h2>
      <p class="mt-4 text-ink-muted">Real projects. Real results. Real people.</p>
    </div>

    <div class="testi-grid">
      {testimonials.map((t, i) => (
        <blockquote class="testi-card reveal" style={`transition-delay:${i * 70}ms`}>
          <div class="stars" aria-label={`${t.stars} out of 5 stars`}>
            {"★".repeat(t.stars)}
          </div>
          <p class="testi-quote">"{t.quote}"</p>
          <footer class="testi-footer">
            <div class="avatar">{t.avatar}</div>
            <div>
              <cite class="testi-name">{t.name}</cite>
              <span class="testi-role">{t.role}</span>
              <span class="testi-tag">{t.industry}</span>
            </div>
          </footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>

<style>
  .testi-grid {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .testi-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1280px) { .testi-grid { grid-template-columns: repeat(4, 1fr); } }

  .testi-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.4rem, 2.5vw, 1.75rem);
    background: var(--glass-bg);
    border: 1px solid var(--glass-brd);
    border-radius: 1.5rem;
    margin: 0;
    transition: border-color 0.3s, background 0.3s, transform 0.3s;
  }
  .testi-card:hover {
    border-color: rgba(96, 165, 250, 0.35);
    background: rgba(255, 255, 255, 0.07);
    transform: translateY(-4px);
  }

  .stars { color: #facc15; font-size: 0.9rem; letter-spacing: 2px; }

  .testi-quote {
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--ink-muted);
    flex: 1;
    margin: 0;
  }

  .testi-footer {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 0.5rem;
  }

  .avatar {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    background: linear-gradient(135deg, var(--brand-deep), var(--brand));
    display: grid;
    place-items: center;
    font-family: "Clash Display", sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.04em;
  }

  .testi-name {
    display: block;
    font-style: normal;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--ink);
  }
  .testi-role {
    display: block;
    font-size: 0.78rem;
    color: var(--ink-faint);
    margin-top: 1px;
  }
  .testi-tag {
    display: inline-block;
    margin-top: 4px;
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 9999px;
    background: rgba(59, 130, 246, 0.12);
    border: 1px solid rgba(59, 130, 246, 0.25);
    color: var(--brand-bright);
  }
</style>
