---
import { PHONE_E164 } from "../data/site";
---
<a href={`tel:${PHONE_E164}`} aria-label="Call us"
   class="call-fab z-50 btn-glass !rounded-full !py-3 !px-5 shadow-lg min-h-[48px] flex items-center"
   style="background: var(--brand-strong); border-color: rgba(255,255,255,0.25); padding-bottom: max(0.75rem, env(safe-area-inset-bottom));">
  <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 flex-none"><path d="M2.01 6.003c-.01-1.104.89-2.003 1.994-2.003h2.04c.93 0 1.73.64 1.94 1.548l.47 2.026a2 2 0 0 1-.58 1.916l-1.2 1.2a14.5 14.5 0 0 0 6.2 6.2l1.2-1.2a2 2 0 0 1 1.916-.58l2.026.47A2 2 0 0 1 18 17.956v2.04c0 1.104-.9 2.004-2.004 1.994C7.44 21.83 2.17 16.56 2.01 6.003Z"/></svg>
  <span class="font-semibold">Call us</span>
</a>

<style>
  .call-fab {
    position: fixed;
    bottom: 1.5rem;
    right: 1rem;
    transition: opacity var(--dur-2) var(--ease-out-quart), transform var(--dur-2) var(--ease-out-quart);
  }
  /* The contact form's inline errors and submit button sit bottom-right; a
     permanently pinned FAB covers them. Step aside while contact is on screen. */
  .call-fab.is-hidden {
    opacity: 0;
    transform: translateY(150%);
    pointer-events: none;
  }
</style>

<script>
  const fab = document.querySelector<HTMLAnchorElement>(".call-fab");
  const contact = document.getElementById("contact");

  if (fab && contact && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      ([entry]) => fab.classList.toggle("is-hidden", entry.isIntersecting),
      { threshold: 0.12 }
    );
    io.observe(contact);
  }
</script>
