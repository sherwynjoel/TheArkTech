---
import "../styles/global.css";
import ParticlesBackground from "../components/ParticlesBackground.astro";
import SEO from "../components/SEO.astro";
---

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet" />
    <link rel="icon" type="image/png" sizes="80x80" href="/logo.png" />
    <SEO
      title="TheArkTech | Software Solutions"
      description="We build modern websites, apps, AI automation, and cloud solutions for small businesses and startups."
      url="https://thearktech.in/"
      image="https://thearktech.in/banner.png"
      siteName="TheArkTech"
      keywords={[
        "web developer in Coimbatore",
        "software development company Coimbatore",
        "best website developer near me",
        "IT services in Coimbatore",
        "best website design company in coimbatore",
        "ecommerce website development company in coimbatore",
        "best website development company in tamilnadu",
        "software company in tamilnadu"
      ]}
    />
  </head>
  <body class="font-sans bg-black text-white">
    

  
    
    <!-- ✅ Navbar -->
    <header class="bg-black/80 backdrop-blur-lg sticky top-0 z-50 border-b border-gray-800">
      <div class="container mx-auto flex justify-between items-center p-4">
        <!-- Logo + Brand Name -->
        <a href="#home" class="flex items-center space-x-3">
          <!-- Small Logo -->
          <img src="/logo.png" alt="TheArkTech Logo" class="h-12 w-16 object-contain" />
          <h1 class="text-2xl font-extrabold text-white tracking-wide">TheArkTech</h1>
        </a>

        <!-- Nav Buttons (desktop) -->
        <nav class="hidden md:flex items-center gap-2">
          <a href="#services" class="px-3 py-2 rounded-lg text-sm font-bold text-gray-300 hover:text-white hover:bg-white/10 transition">
            Services
          </a>
          <a href="#industries" class="px-3 py-2 rounded-lg text-sm font-bold text-gray-300 hover:text-white hover:bg-white/10 transition">
            Industries
          </a>
          <a href="#contact" class="px-3 py-2 rounded-lg text-sm font-bold text-gray-300 hover:text-white hover:bg-white/10 transition">
            Contact
          </a>
          <a href="#contact" class="relative inline-flex items-center justify-center px-4 py-2 rounded-xl border border-white/15 bg-white/5 text-sm font-bold text-white overflow-hidden group transition">
            <span class="relative z-10">Get Quote</span>
            <span class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent translate-x-[-200%] group-hover:translate-x-[200%] transition-transform duration-700 ease-in-out"></span>
          </a>
        </nav>

        <!-- Mobile menu button -->
        <button id="mobile-menu-toggle" aria-controls="mobile-menu" aria-expanded="false" class="md:hidden inline-flex items-center justify-center rounded-md p-2 text-gray-300 hover:text-white hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/20">
          <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
      <!-- Mobile dropdown -->
      <div id="mobile-menu" class="md:hidden hidden border-t border-gray-800 bg-black/90 backdrop-blur px-4 pb-4">
        <div class="flex flex-col gap-2 pt-3">
          <a href="#services" class="px-3 py-2 rounded-lg text-sm font-bold text-gray-300 hover:text-white hover:bg-white/10 transition">Services</a>
          <a href="#industries" class="px-3 py-2 rounded-lg text-sm font-bold text-gray-300 hover:text-white hover:bg-white/10 transition">Industries</a>
          <a href="#contact" class="px-3 py-2 rounded-lg text-sm font-bold text-gray-300 hover:text-white hover:bg-white/10 transition">Contact</a>
          <a href="#contact" class="relative inline-flex items-center justify-center px-4 py-2 rounded-xl border border-white/15 bg-white/5 text-sm font-bold text-white overflow-hidden group transition">
            <span class="relative z-10">Get Quote</span>
            <span class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent translate-x-[-200%] group-hover:translate-x-[200%] transition-transform duration-700 ease-in-out"></span>
          </a>
        </div>
      </div>
    </header>






    <!-- ✅ Hero Section -->
    <section
      id="home"
      class="relative flex items-center justify-center text-center min-h-[90vh] text-white bg-cover bg-center"
      style="background-image: url('/banner.png');"
    >
      <div class="absolute inset-0 bg-black/20"></div>
      <!-- bottom fade to smooth transition into the next section -->
      <div class="absolute inset-x-0 bottom-0 h-32 md:h-48 bg-gradient-to-b from-transparent to-black"></div>
      

      <div class="relative z-10 max-w-3xl px-6 animate-fadeInUp">
  <h1 class="text-4xl font-extrabold mb-6 tracking-tight">TheArkTech — Your Trusted Software Partner</h1>
  <p class="text-lg text-gray-300 mb-8">
    At <span class="font-semibold text-blue-400">TheArkTech</span>, we deliver
    premium end-to-end solutions — from websites & apps to AI-powered
    automation.
  </p>

  <!-- New Fancy CTA Button -->
  <a href="#contact" class="relative inline-flex items-center justify-center px-8 py-3 text-white font-semibold rounded-full overflow-hidden group">
    <span class="relative z-10">Get Started Today</span>
    <span class="cb-btn_cta-border"></span>
  </a>
</div>

    </section>

    <!-- Anime.js full-page cursor overlay -->
    <div class="anim-overlay hidden md:block">
      <div class="anim-dot"></div>
    </div>

    <!-- Persistent Call Us Button -->
    <a href="tel:+919489722142" aria-label="Call us at 9489722142"
       class="fixed bottom-4 right-4 z-50 inline-flex items-center gap-2 px-4 py-3 rounded-full bg-blue-600 text-white shadow-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-400 transition">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
        <path d="M2.01 6.003c-.01-1.104.89-2.003 1.994-2.003h2.04c.93 0 1.73.64 1.94 1.548l.47 2.026a2 2 0 0 1-.58 1.916l-1.2 1.2a14.5 14.5 0 0 0 6.2 6.2l1.2-1.2a2 2 0 0 1 1.916-.58l2.026.47A2 2 0 0 1 18 17.956v2.04c0 1.104-.9 2.004-2.004 1.994C7.44 21.83 2.17 16.56 2.01 6.003Z"/>
      </svg>
      <span class="font-bold tracking-wide">Call us</span>
    </a>


    
    
    

    <!-- Tell Your Ideas Section -->
<section id="ideas" class="text-white py-24 px-6 relative">
  <div class="absolute inset-0 bg-black via-gray-900 to-black z-[-1]"></div>
  <ParticlesBackground particleCount={60} speed={7} />
  <div class="max-w-6xl mx-auto text-center relative z-10">
    
    <h2 class="text-4xl md:text-5xl font-bold mb-6">
      Tell Us Your Ideas, We’ll Build It
    </h2>
    
    <p class="text-lg md:text-xl text-gray-300 max-w-3xl mx-auto mb-10 leading-relaxed">
      Are you a small business owner or a startup looking for a reliable website or app development partner?  
      Do you want to grow your business online with modern, scalable solutions?  
      We are here to turn your ideas into powerful digital products.
    </p>

    <div class="flex flex-col sm:flex-row gap-6 justify-center">
      
      <!-- Fancy Liquid Glass Button -->
      <a href="#contact" 
         class="relative inline-flex items-center justify-center px-8 py-4 text-white font-semibold 
                rounded-full overflow-hidden group backdrop-blur-xl bg-blue-500/20 border border-blue-400/30 shadow-lg">
        <span class="relative z-10">Get a Free Consultation</span>
        <!-- Animated Shine -->
        <span class="absolute inset-0 bg-gradient-to-r from-transparent via-blue-300/40 to-transparent 
                     translate-x-[-200%] group-hover:translate-x-[200%] 
                     transition-transform duration-700 ease-in-out rotate-12"></span>
      </a>

      <!-- Fancy Liquid Glass Button -->
      <a href="#services" 
         class="relative inline-flex items-center justify-center px-8 py-4 text-white font-semibold 
                rounded-full overflow-hidden group backdrop-blur-xl bg-blue-500/20 border border-blue-400/30 shadow-lg">
        <span class="relative z-10">Explore Our Services</span>
        <!-- Animated Shine -->
        <span class="absolute inset-0 bg-gradient-to-r from-transparent via-blue-300/40 to-transparent 
                     translate-x-[-200%] group-hover:translate-x-[200%] 
                     transition-transform duration-700 ease-in-out rotate-12"></span>
      </a>

    </div>

  </div>
 </section>







    <!-- ✅ Why Choose Us -->
